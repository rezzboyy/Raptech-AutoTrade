        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "X Trading\0"
            VALUE "FileDescription",  "X Trading Engine Desktop\0"
            VALUE "FileVersion",      "3.2.0.0\0"
            VALUE "InternalName",     "XTradingEngine\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 X Trading. All rights reserved.\0"
            VALUE "OriginalFilename", "XTradingEngine.exe\0"
            VALUE "ProductName",      "X Trading Engine\0"
            VALUE "ProductVersion",   "3.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
