# Salin file ini menjadi .env lalu isi dengan kredensial akun MT5 Anda.
# JANGAN commit file .env ke git.

MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# Path ke terminal64.exe (opsional, kosongkan jika MT5 sudah terpasang default)
MT5_PATH=

# Parameter trading (akun Exness Standard: simbol berakhiran 'm', mis. EURUSDm)
SYMBOL=EURUSDm
TIMEFRAME=M5
MAGIC_NUMBER=100200

# Manajemen risiko
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=1
